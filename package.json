{
  "name": "projet",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run start",
    "build": "npm-run-all build:backend build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "lint": "npm-run-all lint:backend lint:frontend",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "format": "npm-run-all format:backend format:frontend",
    "format:backend": "npm --prefix backend run format",
    "format:frontend": "npm --prefix frontend run format",
    "test": "npm-run-all test:backend test:frontend --continue-on-error",
    "test:backend": "npm --prefix backend run test --if-present",
    "test:frontend": "npm --prefix frontend run test --if-present",
    "prepare": "echo skip husky"
  },
  "devDependencies": {
    "lint-staged": "^16.1.5",
    "npm-run-all": "^4.1.5"
  },
  "lint-staged": {
    "frontend/**/*.{ts,html,scss,css}": [
      "prettier --write"
    ],
    "backend/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
